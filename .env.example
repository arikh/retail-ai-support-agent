# LLM Provider - choose one
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Settings
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Database
DATABASE_URL=sqlite:///./data/pricing.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Agent Settings
MAX_ITERATIONS=25